# Copy to .env and edit (all optional). The `steltic` command and run_local.sh load it automatically.

# --- data location (default: your OS user-data dir, e.g. %LOCALAPPDATA%\Steltic or ~/.local/share/Steltic) ---
# DATA_DIR=

# --- sandbox executor ---
EXECUTOR=auto                 # auto | docker | subprocess   (auto = Docker if available, else subprocess)
SANDBOX_IMAGE=steel-sandbox:latest
SANDBOX_TIMEOUT=900           # seconds per run_python
SANDBOX_MEM=2g
SANDBOX_CPUS=2
SANDBOX_PIDS=256

# --- engineering-standards RAG (optional) ---
# Empty => the agent's search tool returns a 'use your own knowledge' note and it relies on its own
# cited AISI/CFS knowledge. To enable RAG, either point these at YOUR OWN server (see rag_v2/README.md
# for the expected API), or request access to the hosted Steltic RAG via the contact details at
# https://stelticai.com.
RAG_API_URL=
RAG_API_TOKEN=

# --- DEMO mode (added 2026-08-03; see DEMO_NOTES.md) ---
# DEMO=1 locks the app to the 25 built-in example briefs: the server resolves the
# example KEY itself and IGNORES any client brief/images/name; uploads + restore
# return 403; analysis fidelity is pinned to auto (preflight recommendation).
DEMO=0
DEMO_MAX_RUN_SEC=7200
DEMO_RUNS_PER_DAY=3           # 0 = unlimited (per-day convention)
DEMO_MONTHLY_RUN_HOURS=-1     # 0 = CLOSED (emergency brake), -1 = unlimited (ctl-plane convention)
